# Normalise line endings so contributors on different platforms don't produce
# whole-file diffs. Text files are stored as LF in the repo and checked out
# with the platform's native endings.
* text=auto

*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.scss text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.sppkg binary
